DISCORD_TOKEN=
DISCORD_CLIENT_ID=
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=gemma-4-e4b-it
LLM_API_KEY=local
SETTINGS_DB_PATH=data/patch.sqlite
BOT_IDENTITY_PATH=prompts/identity.json
# Optional identity overrides: BOT_NAME=Patch, BOT_PRONOUNS=she/her, BOT_ALIASES=patch, BOT_PROJECT=Patch, BOT_HOBBIES=drum & bass,future garage
LLM_CONTEXT_TOKENS=16384
LLM_ENABLE_THINKING=false
LLM_THINKING_MAX_TOKENS=1024
LLM_THINKING_TIMEOUT_MS=20000
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.55
# Opt-in one-to-one DM memory through a compatible Remora service.
REMORA_DM_ENABLED=false
# Additional read-only bank selections; server policy grants access (max 7 extras).
REMORA_READ_BANKS=
BOT_OWNER_USER_IDS=
DEBUG_LOGGING=false
LLM_TRACE_LOGGING=false
RESPONSE_CLASSIFIER_ENABLED=false
DM_RESPONSE_CLASSIFIER_ENABLED=false
# Initial history seed for each new chat; subsequent turns grow to the token budget.
DM_CONTEXT_MESSAGE_LIMIT=30
THREAD_CONTEXT_MESSAGE_LIMIT=30
GUILD_RECENT_MESSAGE_LIMIT=10
# The optional classifier's decision input; this does not limit response history.
CLASSIFIER_CONTEXT_MESSAGE_LIMIT=12
# Bot tokens cannot read Discord profile pronouns; add user-id overrides when known.
# DISCORD_PRONOUN_OVERRIDES=123456789=she/her,987654321=they/them
ACTIVITY_UPDATES_ENABLED=false
ACTIVITY_UPDATE_INTERVAL_MS=2700000
PASSIVE_RESPONSE_TTL_MS=30000
MAX_GLOBAL_CONCURRENCY=1

{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "files": {
    "ignore": [".obsidian/**", "node_modules/**", "dist/**", "vendor/**"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}

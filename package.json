{
  "name": "patch-discord-llm-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "postinstall": "pnpm run protocord:build",
    "protocord:build": "pnpm --dir vendor/protocord build",
    "protocord:check": "pnpm --dir vendor/protocord check",
    "dev": "pnpm run protocord:build && tsx watch src/index.ts",
    "build": "pnpm run protocord:build && tsup src/index.ts --format esm --target node24 --clean && tsx test/build-smoke.ts",
    "start": "node dist/index.js",
    "check": "pnpm run protocord:build && biome check . && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "fix": "biome check --write .",
    "test": "vitest run",
    "remora:smoke": "tsx test/remora-smoke.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.78",
    "pino": "^9.6.0",
    "protocord": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

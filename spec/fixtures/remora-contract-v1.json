{
  "version": 1,
  "kind": "Shared contract examples and schemas; not a running-backend capability claim",
  "source_binding": {
    "mode": "final_user_message_exact",
    "description": "Before model rendering, messages[-1] must have role=user and string content equal to remora.turn.text. Caller history contains the current turn only in that final message. Rendering may merge adjacent equal roles with blank lines, without invented assistant turns. Only turn.text is a new write source.",
    "identity": [
      "authenticated principal",
      "write_bank",
      "turn.id",
      "turn.revision"
    ],
    "revision": "Nonnegative integer. Initial revision is 0; edits use a greater source version, such as the edited timestamp. Generation parameters do not change source identity. Changed text/speaker under an existing revision is a 409 source_conflict; older revisions are 409 stale_source_revision. A higher revision supersedes the previous source and invalidates affected memories and reuse.",
    "retry": "A completed source write receipt is durable. Fallback generations may produce another answer, but cannot add, reinforce or extract the same source revision again. Write failures are receipts too."
  },
  "request_extension": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "read_banks": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 8,
        "items": { "type": "string", "minLength": 1 }
      },
      "write_bank": { "type": "string", "minLength": 1 },
      "speaker": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bank", "id"],
        "properties": {
          "bank": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 }
        }
      },
      "identity": { "$ref": "#/definitions/identity" },
      "turn": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "speaker_id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "speaker_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      },
      "recall": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allow": {
            "type": "array",
            "items": { "$ref": "#/definitions/fact_ref" }
          },
          "deny": {
            "type": "array",
            "items": { "$ref": "#/definitions/fact_ref" }
          }
        }
      }
    },
    "required": ["read_banks"]
  },
  "definitions": {
    "identity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "identity_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "identity_speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank", "id"],
      "properties": {
        "bank": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "id": { "$ref": "#/definitions/identity_id" }
      }
    },
    "identity_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank", "role", "id"],
      "properties": {
        "bank": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "role": { "enum": ["human", "assistant"] },
        "id": { "$ref": "#/definitions/identity_id" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistant": { "$ref": "#/definitions/identity_speaker" },
        "bindings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor", "entity"],
            "properties": {
              "actor": { "$ref": "#/definitions/identity_actor" },
              "entity": { "$ref": "#/definitions/identity_id" }
            }
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["actor", "label"],
                "properties": {
                  "actor": { "$ref": "#/definitions/identity_actor" },
                  "label": { "$ref": "#/definitions/identity_label" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["entity", "label"],
                "properties": {
                  "entity": { "$ref": "#/definitions/identity_id" },
                  "label": { "$ref": "#/definitions/identity_label" }
                }
              }
            ]
          }
        }
      }
    },
    "fact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank", "id"],
      "properties": {
        "bank": { "type": "string", "minLength": 1 },
        "id": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "rules": {
    "write_bank_and_turn": "Both present or both absent. A writable destination must be independently granted; reading a bank grants no write permission.",
    "authorization": "Bearer-authenticated server policy grants banks and facts. Requests can only select or narrow those grants. speaker_id is attribution, never authentication.",
    "speaker": "Optional remora.speaker declares the current human's attribution scope: authenticated principal, speaker.bank and exact opaque speaker.id. IDs are not normalized or interpreted. Writable requests infer the same scope from write_bank and turn.speaker_id; an explicit conflicting bank or ID is a 400 speaker_binding_mismatch before inference or bank access. Speaker binding grants no reads, writes or flows and opens no additional bank. An unselected speaker bank can only supply an unmatched attribution scope. Missing identity remains unknown. Recall quotes preserve named third parties and grammatical subjects; a source author is not necessarily the subject. Attribution that changes rendered recall invalidates conditioned memory while compatible bare SYSTEM reuse remains possible.",
    "identity": "Optional remora.identity requires features.entity_identity=true and all four valid advertised identity limits. Missing/false support forbids identity, including {}. Current human remains the existing local speaker; assistant={bank,id} separately designates the current local assistant. Explicit bindings map (principal,bank,role,id) to an entity ID in the server-derived principal namespace. Omitted bindings retain established targets; new bindings require a new writable source/revision for its current actors in the write bank and commit atomically with the receipt. Read-only calls cannot establish/retarget bindings; completed retries cannot retro-create them. Names are optional request-local labels, never identity joins or grants. Known conflicts reject before inference; commit rechecks conflicts atomically. Explicit assistant on a completed retry must match the recorded local bank/id exactly; legacy sources with no assistant record cannot acquire one through a retry. See entity-identity-proposal.md for the accepted lifecycle and source/subject distinction.",
    "recall": "Eligible refs are intersected with server grants and provenance restrictions before retrieval and every refresh. Missing allow means all otherwise permitted refs; allow=[] means none. deny further subtracts refs.",
    "cross_bank_writes": "Reading several banks does not authorize publishing their facts into the write bank. Server policy must grant source-bank to destination-bank flows; derived facts retain restrictive provenance. No implicit permission promotion.",
    "without_extension": "Ordinary generation with no bank access and no writes. No global default bank.",
    "unsupported": "Explicit OpenAI-shaped errors; unsupported tools, thinking, multimodal content, nonzero temperature and streaming are not silently ignored by the first HF backend.",
    "cache_prompt": "Boolean reuse request. false disables reuse. true requires a backend advertising prefix_cache and returns observed token counts, not a reuse guarantee. State changes, edits or context resets may legitimately yield zero reuse.",
    "memory_delivery": "Optional capabilities.memory_delivery discloses the server-selected delivery mode. detached is the existing default with separate virtual attention K/V. HF native-cache is opt-in: selected source-group blocks become ordinary real tokens immediately before the final user message, including on coherent refresh. They consume context and obey native sliding attention. Changing delivery requires a separately configured service/profile, not a request field. Backend=transformers remains HF even with native-cache delivery; this does not select llama.cpp.",
    "cancellation": "Before inference completes, cancellation commits no automatic write. Nonstreaming write and receipt commit atomically before sending the completed response. A disconnect after commit is retried with the same source identity.",
    "history": "The supplied messages are the entire real-token generation history. No independent hidden history, silent eviction or resurrection of caller-discarded turns. Over-budget input is rejected explicitly."
  },
  "capabilities_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "object",
      "version",
      "model",
      "backend",
      "profile",
      "features",
      "limits",
      "source_binding"
    ],
    "properties": {
      "object": { "const": "remora.capabilities" },
      "version": { "const": 1 },
      "model": { "type": "string" },
      "backend": { "enum": ["transformers", "llama.cpp"] },
      "profile": { "type": "string" },
      "memory_delivery": { "enum": ["detached", "native-cache"] },
      "source_binding": { "const": "final_user_message_exact" },
      "features": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memory",
          "automatic_writes",
          "multi_bank",
          "fact_filter",
          "source_revisions",
          "prefix_cache",
          "streaming",
          "tools",
          "thinking"
        ],
        "properties": {
          "memory": { "type": "boolean" },
          "automatic_writes": { "type": "boolean" },
          "multi_bank": { "type": "boolean" },
          "fact_filter": { "type": "boolean" },
          "source_revisions": { "type": "boolean" },
          "prefix_cache": { "type": "boolean" },
          "speaker_binding": { "type": "boolean" },
          "entity_identity": { "type": "boolean" },
          "streaming": { "type": "boolean" },
          "tools": { "type": "boolean" },
          "thinking": { "type": "boolean" }
        }
      },
      "limits": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context_tokens", "max_output_tokens", "max_read_banks"],
        "properties": {
          "context_tokens": { "type": "integer", "minimum": 1 },
          "max_output_tokens": { "type": "integer", "minimum": 1 },
          "max_read_banks": { "const": 8 },
          "max_identity_bindings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "max_identity_labels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "max_identity_id_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "max_identity_label_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          }
        }
      }
    },
    "if": {
      "required": ["features"],
      "properties": {
        "features": {
          "required": ["entity_identity"],
          "properties": { "entity_identity": { "const": true } }
        }
      }
    },
    "then": {
      "required": ["limits"],
      "properties": {
        "limits": {
          "required": [
            "max_identity_bindings",
            "max_identity_labels",
            "max_identity_id_chars",
            "max_identity_label_chars"
          ]
        }
      }
    }
  },
  "capabilities_example": {
    "object": "remora.capabilities",
    "version": 1,
    "model": "gemma-4-e2b-it",
    "backend": "transformers",
    "profile": "gemma-reference-12288",
    "source_binding": "final_user_message_exact",
    "memory_delivery": "detached",
    "features": {
      "memory": true,
      "automatic_writes": true,
      "multi_bank": true,
      "fact_filter": true,
      "source_revisions": true,
      "prefix_cache": true,
      "speaker_binding": true,
      "streaming": false,
      "tools": false,
      "thinking": false
    },
    "limits": {
      "context_tokens": 12288,
      "max_output_tokens": 256,
      "max_read_banks": 8
    }
  },
  "identity_capabilities_example": {
    "object": "remora.capabilities",
    "version": 1,
    "model": "gemma-4-e2b-it",
    "backend": "transformers",
    "profile": "gemma-reference-12288",
    "source_binding": "final_user_message_exact",
    "memory_delivery": "detached",
    "features": {
      "memory": true,
      "automatic_writes": true,
      "multi_bank": true,
      "fact_filter": true,
      "source_revisions": true,
      "prefix_cache": true,
      "speaker_binding": true,
      "entity_identity": true,
      "streaming": false,
      "tools": false,
      "thinking": false
    },
    "limits": {
      "context_tokens": 12288,
      "max_output_tokens": 256,
      "max_read_banks": 8,
      "max_identity_bindings": 16,
      "max_identity_labels": 64,
      "max_identity_id_chars": 256,
      "max_identity_label_chars": 128
    }
  },
  "response_extension_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "backend",
      "read_banks",
      "selected",
      "writes",
      "cache"
    ],
    "properties": {
      "version": { "const": 1 },
      "backend": { "enum": ["transformers", "llama.cpp"] },
      "read_banks": { "type": "array", "items": { "type": "string" } },
      "selected": {
        "type": "array",
        "items": { "$ref": "#/definitions/fact_ref" }
      },
      "writes": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["bank", "source_id", "revision", "replayed", "result"],
            "properties": {
              "bank": { "type": "string" },
              "source_id": { "type": "string" },
              "revision": { "type": "integer", "minimum": 0 },
              "replayed": { "type": "boolean" },
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "saved",
                  "reinforced",
                  "superseded",
                  "forgotten",
                  "error",
                  "unmatched_forget"
                ],
                "properties": {
                  "saved": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                  },
                  "reinforced": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                  },
                  "superseded": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                  },
                  "forgotten": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                  },
                  "error": { "type": ["string", "null"] },
                  "unmatched_forget": { "type": "boolean" }
                }
              }
            }
          }
        ]
      },
      "cache": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requested",
          "reused_tokens",
          "evaluated_tokens",
          "invalidated"
        ],
        "properties": {
          "requested": { "type": "boolean" },
          "reused_tokens": { "type": "integer", "minimum": 0 },
          "evaluated_tokens": { "type": "integer", "minimum": 0 },
          "invalidated": { "type": ["string", "null"] }
        }
      }
    }
  },
  "request_example": {
    "model": "gemma-4-e2b-it",
    "messages": [
      {
        "role": "system",
        "content": "Answer briefly. The final user message is the new turn."
      },
      {
        "role": "user",
        "content": "Prior caller-owned transcript and participant context."
      },
      { "role": "user", "content": "My piano teacher is Elin." }
    ],
    "temperature": 0,
    "max_tokens": 64,
    "cache_prompt": true,
    "chat_template_kwargs": { "enable_thinking": false },
    "remora": {
      "read_banks": ["discord:dm:example"],
      "write_bank": "discord:dm:example",
      "turn": {
        "id": "discord:message:example",
        "revision": 0,
        "speaker_id": "discord:user:example",
        "text": "My piano teacher is Elin."
      }
    }
  },
  "readonly_speaker_request_example": {
    "model": "gemma-4-e2b-it",
    "messages": [{ "role": "user", "content": "Who is my piano teacher?" }],
    "temperature": 0,
    "max_tokens": 64,
    "cache_prompt": true,
    "remora": {
      "read_banks": ["discord:dm:example"],
      "speaker": { "bank": "discord:dm:example", "id": "discord:user:example" }
    }
  },
  "identity_request_example": {
    "model": "gemma-4-e2b-it",
    "messages": [{ "role": "user", "content": "I have a dog." }],
    "temperature": 0,
    "max_tokens": 64,
    "cache_prompt": true,
    "remora": {
      "read_banks": ["place:a"],
      "write_bank": "place:a",
      "turn": {
        "id": "event:1",
        "revision": 0,
        "speaker_id": "local:7",
        "text": "I have a dog."
      },
      "identity": {
        "assistant": { "bank": "place:a", "id": "account:helper" },
        "bindings": [
          {
            "actor": { "bank": "place:a", "role": "human", "id": "local:7" },
            "entity": "person:alpha"
          }
        ],
        "labels": [{ "entity": "person:alpha", "label": "Alex" }]
      }
    }
  },
  "response_example": {
    "id": "chatcmpl-example",
    "object": "chat.completion",
    "created": 0,
    "model": "gemma-4-e2b-it",
    "choices": [
      {
        "index": 0,
        "message": { "role": "assistant", "content": "Got it." },
        "finish_reason": "stop"
      }
    ],
    "usage": {
      "prompt_tokens": 100,
      "completion_tokens": 3,
      "total_tokens": 103
    },
    "remora": {
      "version": 1,
      "backend": "transformers",
      "read_banks": ["discord:dm:example"],
      "selected": [],
      "writes": {
        "bank": "discord:dm:example",
        "source_id": "discord:message:example",
        "revision": 0,
        "replayed": false,
        "result": {
          "saved": [1],
          "reinforced": [],
          "superseded": [],
          "forgotten": [],
          "error": null,
          "unmatched_forget": false
        }
      },
      "cache": {
        "requested": true,
        "reused_tokens": 0,
        "evaluated_tokens": 103,
        "invalidated": null
      }
    }
  },
  "error_examples": [
    {
      "status": 400,
      "body": {
        "error": {
          "message": "The writable assistant must belong to the write bank",
          "type": "invalid_request_error",
          "param": "remora.identity.assistant",
          "code": "identity_actor_mismatch"
        }
      }
    },
    {
      "status": 400,
      "body": {
        "error": {
          "message": "The binding must refer to a selected read bank or the write bank",
          "type": "invalid_request_error",
          "param": "remora.identity.bindings",
          "code": "identity_scope_invalid"
        }
      }
    },
    {
      "status": 400,
      "body": {
        "error": {
          "message": "Only one label may be supplied for a resolved identity",
          "type": "invalid_request_error",
          "param": "remora.identity.labels",
          "code": "identity_label_conflict"
        }
      }
    },
    {
      "status": 409,
      "body": {
        "error": {
          "message": "The actor already has a different entity binding",
          "type": "invalid_request_error",
          "param": "remora.identity.bindings",
          "code": "identity_binding_conflict"
        }
      }
    },
    {
      "status": 409,
      "body": {
        "error": {
          "message": "This request cannot establish the actor binding",
          "type": "invalid_request_error",
          "param": "remora.identity.bindings",
          "code": "identity_binding_not_established"
        }
      }
    },
    {
      "status": 409,
      "body": {
        "error": {
          "message": "The completed source has a different assistant attribution",
          "type": "invalid_request_error",
          "param": "remora.identity.assistant",
          "code": "source_identity_conflict"
        }
      }
    },
    {
      "status": 400,
      "body": {
        "error": {
          "message": "Speaker must match the source turn",
          "type": "invalid_request_error",
          "param": "remora.speaker",
          "code": "speaker_binding_mismatch"
        }
      }
    },
    {
      "status": 400,
      "body": {
        "error": {
          "message": "The final user message must equal remora.turn.text",
          "type": "invalid_request_error",
          "param": "remora.turn.text",
          "code": "source_binding_mismatch"
        }
      }
    },
    {
      "status": 403,
      "body": {
        "error": {
          "message": "The selected bank is not authorized",
          "type": "permission_error",
          "param": "remora.read_banks",
          "code": "bank_forbidden"
        }
      }
    },
    {
      "status": 409,
      "body": {
        "error": {
          "message": "The source revision has different text or speaker",
          "type": "invalid_request_error",
          "param": "remora.turn",
          "code": "source_conflict"
        }
      }
    },
    {
      "status": 409,
      "body": {
        "error": {
          "message": "A newer source revision already exists",
          "type": "invalid_request_error",
          "param": "remora.turn.revision",
          "code": "stale_source_revision"
        }
      }
    },
    {
      "status": 400,
      "body": {
        "error": {
          "message": "The backend does not support the requested feature",
          "type": "invalid_request_error",
          "param": "tools",
          "code": "unsupported_feature"
        }
      }
    }
  ]
}
